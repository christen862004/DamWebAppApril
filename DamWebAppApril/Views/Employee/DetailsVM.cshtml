@model EmpWithGradeLevelDeptListViewModel

@* @using DamWebAppApril.ViewModel
@model EmpWithGradeLevelDeptListViewModel *@

@* @model DamWebAppApril.ViewModel.EmpWithGradeLevelDeptListViewModel *@
@{
    ViewData["Title"] = "DetailsVM";
}

<h1>DetailsVM</h1>
<h1 style="color:@Model.Color">@Model.EmpName</h1>
<h1>@Model.Level</h1>
<h1>@(Model.Grade+1)</h1>
<select class="form form-control">
    @foreach (var item in Model.DeptList)
    {
        <option>@item.Name</option>
    }
</select>