@model EmpWithDeptListViewModel
@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>
<!--/Employee/SaveEdit/1
    Name=ahmed,Salary=10000,ImageURl=m.png,DepartmentID=1
-->

<form asp-action="SaveEdit" asp-controller="Employee" asp-route-id="@Model.Id" method="post">
    @* <input type="hidden" name="ID" value="@Model.Id" /> *@
    <div>
        <!--Tag Helper-->
        <label asp-for="EmpName"></label>
        <input class="form-control"  asp-for="EmpName"/> 
       
        <!--Pure HTML-->
       @*  <label>Name</label>
        <input class="form-control" type="text" id="EmpName" name="EmpName" value="@Model?.EmpName" /> *@
        <!--Pure C# HTML Helper-->
        @* @Html.LabelFor(e => e.EmpName) *@
        @* @Html.TextBoxFor(e => e.EmpName,
            htmlAttributes: new { style = "color:red",@class="form-control" }) *@
@* 
        @Html.EditorFor(e=>e.EmpName) *@
    </div>
    <div>
        <label>Salary</label>
        <input class="form-control" type="number" id="NetSalary" name="NetSalary" value="@Model?.NetSalary" />
    </div>
    <div>
        <label>ImageURl</label>
        <input class="form-control" type="text" id="ImageURl" name="ImageURl" value="@Model?.ImageURl" />
    </div>
    <div>
        <label>Department</label>
        @* <input class="form-control" type="number" id="DepartmentID" name="DepartmentID" value="@Model?.DepartmentID" /> *@
         <select class="form-control" id="DepartmentID" name="DepartmentID"  >
             @foreach (Department deptItem in Model.DeptList)
            {
                if (Model.DepartmentID == deptItem.Id)
                {
                    <option value="@deptItem.Id"selected>@deptItem.Name</option>
                }
                else
                {
                    <option value="@deptItem.Id">@deptItem.Name</option>

                }
            }
         </select>
    </div>
    <input type="submit" value="Save" class="btn btn-success"/>
</form>

<a href="/Employee">Back To List</a> - <!--relative on Domian-->
<a href="/Employee/Index">Back To List</a> - 
@Html.ActionLink(linkText:"Back To List",actionName:"Index",controllerName:"Employee") - 
<a asp-action="Index" asp-controller="Employee">Back To List</a> -

